@page
@model IndexModel
@{
    ViewData["Title"] = "Calculadora";
}

<div class="text-center">
    <h1 class="display-4">Bienvenido a la Calculadora</h1>
    <p>Aprende a construir aplicaciones web con <a href="https://learn.microsoft.com/aspnet/core">ASP.NET Core</a>.</p>

    <h2>Calculadora</h2>
    <form method="post">
        <div>
            <label for="numero1">Número 1:</label>
            <input type="number" id="numero1" name="Numero1" value="@Model.Numero1" class="form-control" required />
        </div>
        <div>
            <label for="numero2">Número 2:</label>
            <input type="number" id="numero2" name="Numero2" value="@Model.Numero2" class="form-control" required />
        </div>

        <div>
            <label for="operacion">Operación:</label>
            <select id="operacion" name="Operacion" class="form-control" required>
                <option value="Suma" selected="@(Model.Operacion == "Suma")">Suma</option>
                <option value="resta" selected="@(Model.Operacion == "resta")">Resta</option>
            </select>
        </div>

        <div>
            <button type="submit" class="btn btn-primary mt-3">Calcular</button>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.Resultado))
    {
        <h3>Resultado: @Model.Resultado</h3>
    }
</div>
